VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Android APK build (Capacitor) ─────────────────────────────────────────────
# These same values are baked into the APK at build time via `npm run build:android`.
# Copy production values from Vercel → use in local `.env` before building the app.
# The verify-mobile-build-env script blocks builds with placeholders.

# Optional: app version shown in Profile (web + build scripts)
# VITE_APP_VERSION=1.0.0

# Optional: enable native FCM push (Phase 2 only — requires google-services.json)
# VITE_ENABLE_NATIVE_PUSH=false
# VITE_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000

# Optional: show maintenance screen on Vercel host only
# Set to "true" in Vercel environment variables when needed
# VITE_MAINTENANCE_MODE=false
