# Copy this file to android/keystore.properties (gitignored).
# Used only if you build a signed APK from the command line.
# Android Studio "Generate Signed APK" does not require this file.
#
# Keep the .jks file OUTSIDE the git repo (Documents folder is fine).
# Use forward slashes in the path.

storeFile=C:/Users/YOUR_NAME/Documents/Maktree-keys/maktree-sfa-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=maktree
keyPassword=YOUR_KEY_PASSWORD
